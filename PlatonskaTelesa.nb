Cell[CellGroupData[{

Cell["Kaj so Platoni\[CHacek]na telesa?", "Subsection",
 CellChangeTimes->{{3.997004411405631*^9, 
  3.997004421901493*^9}},ExpressionUUID->"029121f4-edf2-4def-83d8-\
f1deb21d69d4"],

Cell[TextData[{
 "Platoni\[CHacek]na telesa so pravilni konveksni poliedri. Vse njihove \
ploskve so skladni pravilni mnogokotniki, v vsakem ogli\[SHacek]\[CHacek]u pa \
se stika enako \[SHacek]tevilo ploskev.\n\n",
 StyleBox["Lastnosti:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{
  3.997004516221801*^9, {3.9970045517206993`*^9, 
   3.997004635782278*^9}},ExpressionUUID->"090e43a7-13b7-4db8-9954-\
fb5da02d162e"],

Cell["Vse ploskve so enake,", "Item",
 CellChangeTimes->{{3.997004656016433*^9, 3.997004676865139*^9}, 
   3.997004718101715*^9},ExpressionUUID->"77f9fa55-6e92-4e59-80b0-\
7ded7208e33f"],

Cell["vse stranice so enako dolge,", "Item",
 CellChangeTimes->{{3.997004656016433*^9, 3.9970046862756443`*^9}, 
   3.9970047185672207`*^9},ExpressionUUID->"b40d69e5-446d-47a6-aba8-\
ea5b42a73581"],

Cell["vsa ogli\[SHacek]\[CHacek]a so med seboj enakovredna,", "Item",
 CellChangeTimes->{{3.997004656016433*^9, 
  3.997004719211965*^9}},ExpressionUUID->"393f92d7-6162-40bc-904b-\
addf1ea4a8be"],

Cell["so konveksna,", "Item",
 CellChangeTimes->{{3.997004656016433*^9, 
  3.997004719872135*^9}},ExpressionUUID->"222614d0-ccc1-4f89-9faf-\
88e4e42215f4"],

Cell["obsaja jih samo 5.", "Item",
