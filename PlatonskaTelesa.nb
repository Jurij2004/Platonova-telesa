Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"text", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"\"\<https://en.wikipedia.org/wiki/Platonic_solid\>\"", 
      ",", "\"\<Plaintext\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zapisKocke", "=", 
   RowBox[{"First", "[", 
    RowBox[{"StringCases", "[", 
     RowBox[{"text", ",", 
      RowBox[{
      "RegularExpression", 
       "[", "\"\<\\\\(\\\\s*\[PlusMinus]1\\\\s*,\\\\s*\[PlusMinus]1\\\\s*,\\\\\
s*\[PlusMinus]1\\\\s*\\\\)\>\"", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"odstrani", "=", 
   RowBox[{"StringSplit", "[", 
    RowBox[{
     RowBox[{"StringReplace", "[", 
      RowBox[{"zapisKocke", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<(\>\"", "->", "\"\<\>\""}], ",", 
         RowBox[{"\"\<)\>\"", "->", "\"\<\>\""}], ",", 
         RowBox[{"\"\< \>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}], 
     ",", "\"\<,\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"moznosti", "=", 
   RowBox[{"odstrani", "/.", " ", 
    RowBox[{"\"\<\[PlusMinus]1\>\"", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kockaT", "=", 
   RowBox[{"Tuples", "[", "moznosti", "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ConvexHullMesh", "[", "kockaT", "]"}], ",", 
   RowBox[{"Boxed", "->", "False"}], ",", 
   RowBox[{"ImageSize", "->", "400"}]}], "]"}]}], "Input",
